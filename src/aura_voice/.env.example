# AURA Voice API Keys
# Copy this file to ~/.aura/.env and fill in your keys
# NEVER commit actual keys to version control

# Groq API Key (for STT + LLM + English TTS)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=

# ElevenLabs API Key (for Kannada TTS)
# Get yours at: https://elevenlabs.io/
ELEVENLABS_API_KEY=

# OpenRouter API Key (optional LLM fallback)
# Get yours at: https://openrouter.ai/
OPENROUTER_API_KEY=

