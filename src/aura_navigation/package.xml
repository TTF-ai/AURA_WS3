<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aura_navigation</name>
  <version>0.0.1</version>
  <description>Nav2 navigation configuration for the AURA robot</description>
  <maintainer email="thirumaleshk549@gmail.com">thirumalesh</maintainer>
  <license>Apache-2.0</license>

  <depend>ament_index_python</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>nav2_amcl</depend>
  <depend>nav2_behaviors</depend>
  <depend>nav2_bt_navigator</depend>
  <depend>nav2_controller</depend>
  <depend>nav2_lifecycle_manager</depend>
  <depend>nav2_map_server</depend>
  <depend>nav2_planner</depend>
  <depend>rviz2</depend>

  <test_depend>ament_copyright</test_depend>
